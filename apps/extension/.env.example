# Optional: override the panel's look-back link (defaults to https://www.mindyourprompt.us).
# Copy to .env.local, e.g. to point at a local website build.
VITE_WEBSITE_URL=http://localhost:3000
# Public URL only. Never put Snowflake credentials in VITE_ variables.
# Defaults to localhost:3000 for the local demo. Rebuild after changing.
VITE_API_BASE_URL=http://localhost:3000
